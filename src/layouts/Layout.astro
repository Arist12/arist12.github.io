---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; noindex?: boolean; article?: boolean; }
const { title = profile.name, description = profile.description, noindex = false, article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfcfc" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <slot />
      <footer class="site-footer"><span>{profile.name}</span><span>© {new Date().getFullYear()}</span></footer>
    </div>
  </body>
</html>
