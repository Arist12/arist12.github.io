---
import 'katex/dist/katex.min.css';
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { profile } from '../data/profile';
import { formatDate } from '../lib/posts';
interface Props {
  title: string;
  description: string;
  date: Date;
  headings?: MarkdownHeading[];
  preview?: boolean;
}
const { title, description, date, headings = [], preview = false } = Astro.props;
---
<Layout title={`${title} — ${profile.name}`} description={description} noindex={preview} article>
  <SiteHeader active="writing" />
  <main id="main" class="article-page">
    <article>
      <header class="article-header">
        {preview && <p class="preview-label">Layout preview · unpublished</p>}
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta"><span>{profile.name}</span><span aria-hidden="true">·</span><time datetime={date.toISOString()}>{formatDate(date)}</time></div>
      </header>
      <TableOfContents headings={headings} />
      <div class="prose"><slot /></div>
      <nav class="article-bottom" aria-label="Article navigation"><a class="back-link" href="/writing/">← All writing</a></nav>
    </article>
  </main>
</Layout>
