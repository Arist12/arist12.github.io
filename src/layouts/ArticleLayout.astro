---
import 'katex/dist/katex.min.css';
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { profile } from '../data/profile';
import { formatDate } from '../lib/posts';
interface Props {
  title: string;
  description: string;
  date: Date;
  /** Estimated reading time in minutes, from readingMinutes(). */
  readingTime?: number;
  headings?: MarkdownHeading[];
  preview?: boolean;
  hero?: { src: string; narrow?: string; alt: string; caption?: string };
}
const { title, description, date, readingTime, headings = [], preview = false, hero } = Astro.props;
// The contents column reads the view timelines of the sections; this ancestor makes their names visible to it.
const timelines = headings
  .filter(heading => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label')
  .map((_, index) => `--toc-${index + 1}`)
  .join(', ');
---
<Layout title={`${title} — ${profile.name}`} description={description} noindex={preview} article>
  <SiteHeader active="writing" />
  <main id="main" class="article-page">
    <article>
      <header class="article-header">
        {preview && <p class="preview-label">Layout preview · unpublished</p>}
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta"><span>{profile.name}</span><span aria-hidden="true">·</span><time datetime={date.toISOString()}>{formatDate(date)}</time>{readingTime && <><span aria-hidden="true">·</span><span>{readingTime} min read</span></>}</div>
      </header>
      {hero && (
        <figure class="article-hero">
          <picture>
            {hero.narrow && <source media="(max-width: 520px)" srcset={hero.narrow} />}
            <img src={hero.src} alt={hero.alt} />
          </picture>
          {hero.caption && <figcaption>{hero.caption}</figcaption>}
        </figure>
      )}
      <div class="article-body" style={timelines ? `timeline-scope: ${timelines}` : undefined}>
        <TableOfContents headings={headings} />
        <div class="prose"><slot /></div>
      </div>
      <nav class="article-bottom" aria-label="Article navigation"><a class="back-link" href="/writing/">← All writing</a></nav>
    </article>
  </main>
</Layout>
