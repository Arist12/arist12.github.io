---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
<ul class="post-list">{posts.map(post => <li>
  <a class:list={['post-card', { 'has-cover': post.data.cover }]} href={`/writing/${post.id}/`}>
    {post.data.cover && <img class="post-cover" src={post.data.cover} alt="" loading="lazy" decoding="async" />}
    <div class="post-summary">
      <span class="post-title">{post.data.title}</span>
      <p>{post.data.description}</p>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </div>
  </a>
</li>)}</ul>
