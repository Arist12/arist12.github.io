---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
// `footnote-label` is the visually hidden heading GitHub-flavoured footnotes emit.
const sections = Astro.props.headings.filter(
  heading => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label',
);
// Only the `##` parts are listed, so the column stays a short map of the article. Each entry follows the view
// timeline of its section; rehype-toc-sections.mjs numbers `##` and `###` sections together, in document order.
const parts = sections.map((item, index) => ({ item, n: index + 1 })).filter(({ item }) => item.depth === 2);
---
{parts.length > 2 && (
  <nav class="toc" aria-labelledby="toc-title">
    <p id="toc-title" class="toc-title">Contents</p>
    <ol>{parts.map(({ item, n }) => (
      <li><a href={`#${item.slug}`} style={`--toc-timeline: --toc-${n}`}>{item.text}</a></li>
    ))}</ol>
  </nav>
)}
