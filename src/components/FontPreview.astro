---
import Layout from '../layouts/Layout.astro';
import { fontOptions } from '../data/font-options';
import '../styles/font-preview.css';
---
<Layout title="姓名字体对比 — Yikai Zhang" noindex>
  <main id="main" class="font-comparison">
    <header class="comparison-heading">
      <div><h1>姓名字体对比</h1><p>点击左侧字体，在完整首页里比较。选好后告诉我编号。</p></div>
      <a class="back-link" href="/">返回主页 ↗</a>
    </header>
    <div class="comparison-grid">
      <fieldset class="font-options">
        <legend class="sr-only">选择姓名字体</legend>
        {fontOptions.map((option, index) => <label class="font-option">
          <input type="radio" name="name-font" value={option.id} checked={index === 0} data-font-name={option.name} />
          <span class="option-label"><span>{option.number}</span>{option.name}</span>
          <span class="font-swatch" style={option.style}>Yikai Zhang</span>
          <span class="option-description">{option.description}</span>
        </label>)}
      </fieldset>
      <section class="live-preview" aria-label="完整首页预览">
        <div class="preview-toolbar"><span id="selected-font" aria-live="polite">01 · Instrument Serif Italic</span><a id="open-font" href="/preview/type/instrument-italic/" target="_blank" rel="noopener">单独打开 ↗</a></div>
        <iframe id="font-frame" title="Instrument Serif Italic 首页预览" src="/preview/type/instrument-italic/"></iframe>
      </section>
    </div>
    <p class="comparison-note">这里只是字体试排，主页仍保留原来的字体。字体来源：{fontOptions.slice(0,4).map((font, index) => <><span>{index > 0 ? ' / ' : ''}</span><a href={font.source} target="_blank" rel="noopener noreferrer">{font.name.replace(' Italic','')}</a></>)}</p>
  </main>
</Layout>
<script>
  const frame = document.querySelector<HTMLIFrameElement>('#font-frame');
  const selected = document.querySelector<HTMLElement>('#selected-font');
  const openLink = document.querySelector<HTMLAnchorElement>('#open-font');
  document.querySelectorAll<HTMLInputElement>('input[name="name-font"]').forEach((input, index) => {
    input.addEventListener('change', () => {
      if (!input.checked || !frame || !selected || !openLink) return;
      const name = input.dataset.fontName ?? input.value;
      const url = `/preview/type/${input.value}/`;
      frame.src = url;
      frame.title = `${name} 首页预览`;
      selected.textContent = `${String(index + 1).padStart(2, '0')} · ${name}`;
      openLink.href = url;
    });
  });
</script>
<style>
  :global(body:has(.font-comparison) .site-shell) { width: min(1280px, calc(100% - 64px)); }
  :global(body:has(.font-comparison) .site-footer) { display: none; }
  .font-comparison { padding: 44px 0 30px; }
  .comparison-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  h1 { font-size: 1.4rem; font-weight: 550; letter-spacing: -.4px; }
  .comparison-heading p { margin-top: 10px; font-size: .875rem; line-height: 1.7; color: var(--muted); }
  .comparison-heading>a { white-space: nowrap; }
  .comparison-grid { display: grid; grid-template-columns: 318px minmax(0,1fr); gap: 26px; align-items: start; }
  .font-options { display: grid; gap: 10px; padding: 0; margin: 0; border: 0; min-width: 0; }
  .font-option { display: block; position: relative; padding: 14px 18px 13px; border: 1px solid var(--line); border-radius: 7px; cursor: pointer; transition: background .15s, border-color .15s; }
  .font-option:hover { background: #f6f6f8; }
  .font-option:has(input:checked) { border-color: #8d9fdb; background: #f0f3fc; }
  .font-option:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .option-label { display: flex; gap: 9px; font-size: .75rem; color: #555862; line-height: 1.6; }
  .option-label>span { color: var(--muted); font-variant-numeric: tabular-nums; }
  .font-swatch { display: block; font-size: 2.5rem !important; line-height: 1.3; padding: 5px 0; }
  .option-description { display: block; font-size: .75rem; color: #74767e; line-height: 1.7; }
  .live-preview { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; min-width: 0; background: #fcfcfc; }
  .preview-toolbar { display: flex; justify-content: space-between; gap: 15px; align-items: center; border-bottom: 1px solid var(--line); padding: 14px 18px; font-size: .75rem; line-height: 1.6; color: var(--muted); }
  .preview-toolbar a { white-space: nowrap; color: var(--accent); }
  iframe { display: block; width: 100%; height: 820px; border: 0; background: #fcfcfc; }
  .comparison-note { font-size: .75rem; color: var(--muted); line-height: 1.9; margin-top: 22px; }
  .comparison-note a { text-decoration: underline; text-underline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 950px) {
    .comparison-grid { grid-template-columns: 1fr; }
    .font-options { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
  @media (max-width: 580px) {
    :global(body:has(.font-comparison) .site-shell) { width: calc(100% - 32px); }
    .font-comparison { padding-top: 28px; }
    .comparison-heading { align-items: start; flex-direction: column; gap: 12px; }
    .font-option { padding: 12px; }
    .option-label { display: block; font-size: .75rem; }
    .option-label>span { margin-right: 7px; }
    .font-swatch { font-size: 1.95rem !important; letter-spacing: -1px !important; }
    .option-description { font-size: .75rem; }
    .preview-toolbar { padding: 12px; }
  }
</style>
